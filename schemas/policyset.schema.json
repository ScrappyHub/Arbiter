{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arbiter/schemas/policyset.schema.json",
  "title": "PolicySet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "engine", "evaluation", "rule_files"],
  "properties": {
    "schema": { "const": "policy.policyset.v1" },
    "policyset_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },

    "effective_from": { "type": "string", "description": "RFC3339 timestamp." },
    "expires_at": { "type": "string", "description": "RFC3339 timestamp." },

    "engine": { "const": "arbiter.v1" },

    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["FIRST_MATCH_WINS"] }
      }
    },

    "rule_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Repo-relative path to a JSON rule file that MUST validate as policy.rule_file.v1."
      }
    },

    "trust_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_namespaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required_principals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required_key_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },

    "notes": { "type": "string" }
  }
}
